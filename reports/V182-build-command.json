  "-std=c++17",
  "-O3",
  "-flto",
  "-mcpu=apple-m4",
  "-ffp-contract=off",
  "-DCORE_PHASE_MAJOR=1",
  "-DCORE_FAST30_PROFILE=1",
  "-DCORE_FAST15_PROFILE=1",
  "-DCORE_FAST12_PROFILE=1",
  "-DCORE_BUFFERED_INPUT=1",
  "-DCORE_PACKED_NEAR=1",
  "-DCORE_BATCH_SIZE=16",
  "-DCORE_SHARED_CORRIDOR=1",
